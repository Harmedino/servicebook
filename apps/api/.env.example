# MongoDB connection string (must point at a replica set — e.g. an Atlas cluster —
# since booking creation relies on multi-document transactions).
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/servicebook?retryWrites=true&w=majority"

# Generate a strong secret, e.g.: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# Frontend origin allowed to call this API (comma-separated if you need more than one).
CORS_ORIGIN="http://localhost:5173"
