# MongoDB connection string. A local `mongodb://127.0.0.1:27017/servicebook`
# works for now; a replica set (e.g. a free MongoDB Atlas cluster) will be
# required once booking creation starts using multi-document transactions.
MONGODB_URI="mongodb://127.0.0.1:27017/servicebook"

# Generate a strong secret, e.g.: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# Frontend origin allowed to call this API (comma-separated if you need more than one).
CORS_ORIGIN="http://localhost:5173"

# Email is optional. Leave EMAIL_PROVIDER unset (or "console") for local dev —
# emails are logged instead of sent, nothing here is required to run the app.
# For real delivery, set EMAIL_PROVIDER="resend" plus:
#   EMAIL_FROM="ServiceBook <notifications@yourdomain.com>"
#   EMAIL_API_KEY="<your Resend API key>"
EMAIL_PROVIDER="console"
EMAIL_FROM=""
EMAIL_API_KEY=""
