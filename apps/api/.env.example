# ---- Required in production (Render → Environment) ----------------------
# Locally these fall back to development defaults, so `pnpm dev` works without a .env.

# MongoDB connection string. Must be a replica set (every MongoDB Atlas cluster is one):
# booking creation uses multi-document transactions.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/servicebook?retryWrites=true&w=majority"

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# Frontend origin(s) allowed to call this API, comma-separated, no trailing slash.
# A "*" wildcard is allowed, e.g. https://servicebook-*.vercel.app for Vercel previews.
CORS_ORIGIN="http://localhost:5173"

# ---- Optional ------------------------------------------------------------
NODE_ENV=development
# Render sets PORT automatically; 4000 is only the local default.
PORT=4000
JWT_EXPIRES_IN="7d"

# Email: leave EMAIL_PROVIDER as "console" to log emails instead of sending them.
# For real delivery set EMAIL_PROVIDER="resend" plus both of these (required then):
#   EMAIL_FROM="ServiceBook <notifications@yourdomain.com>"
#   EMAIL_API_KEY="<your Resend API key>"
EMAIL_PROVIDER="console"
EMAIL_FROM=""
EMAIL_API_KEY=""
